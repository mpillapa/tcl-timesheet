# Plantilla de secrets.toml. No contiene credenciales reales.
# Copia este archivo como `.streamlit/secrets.toml` y llena los valores.
# El archivo real está en .gitignore y no se sube al repositorio.

# Super admins con acceso al dashboard. Un bloque por usuario.
[super_admins.usuario1]
password = "PON_CLAVE"
nombre = "Nombre Completo"
rol = "Cargo"

# (Agrega más [super_admins.xxx] según necesites.)

[auth]
# Tokens de dispositivo: PCs/tablets confiables.
# Se accede con URL tipo https://tu-app.streamlit.app/?device_key=TOKEN
device_keys = ["cambiar-por-token-del-pc-de-oficina"]

# Contraseña maestra: acceso desde cualquier lugar sin device_key.
master_password = "PON_TU_CLAVE_MAESTRA_AQUI"

# (Opcional, legado) IPs autorizadas. Inútil en Streamlit Cloud.
allowed_ips = []

# --- Base de datos principal: PostgreSQL en Supabase -----------------------
# Copiar desde Supabase: Connect -> Session pooler (compatible con IPv4,
# necesario para Streamlit Cloud). Reemplaza [YOUR-PASSWORD] por la clave
# de la base (Database password del proyecto).
[connections.supabase]
url = "postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Respaldo en Google Sheets ----------------------------------------------
# true  = cada escritura se replica también en el Sheet (respaldo).
# false = solo base de datos (apaga el espejo sin tocar código).
[backup]
espejo_sheets = true

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/TU_SPREADSHEET_ID_AQUI/edit"
worksheet = "Registros"

# --- Credenciales del Service Account (JSON descargado de Google Cloud) ---
type = "service_account"
project_id = "tu-proyecto-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEv...TODO_EL_CONTENIDO...==\n-----END PRIVATE KEY-----\n"
client_email = "marcador-horas@tu-proyecto-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/marcador-horas%40tu-proyecto-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
